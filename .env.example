# Site configuration
# The canonical origin, no trailing slash. Required in production.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=WebTools
# Optional. Shown on /about and /privacy when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Search-engine ownership verification. Public tokens, rendered as meta tags.
# Google: Search Console -> URL-prefix property -> HTML tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing: Webmaster Tools -> Verify -> meta tag (msvalidate.01).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional analytics. Leave empty to ship with no tracker and no consent banner.
NEXT_PUBLIC_ANALYTICS_ID=

# Optional CMS webhook (Sanity). Endpoint: POST /api/revalidate
SANITY_REVALIDATE_SECRET=
